{
  "name": "quotation-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:regression": "node scripts/regression.mjs",
    "test:regression:coverage": "tsx tests/regression/coverage-map.ts",
    "test:regression:affected": "tsx tests/regression/affected-runner.ts",
    "test:regression:report": "tsx scripts/regression-report.mjs",
    "migrate:design-v2": "tsx prisma/migrate-design-v1-to-v2.ts",
    "backfill:audit-log": "tsx prisma/backfill-audit-log-labels.ts",
    "backfill:config-snapshot": "tsx prisma/backfill-config-snapshots.ts",
    "backfill:formula-pins": "tsx prisma/backfill-formula-set-pins.ts",
    "backfill:inventory-component-type": "tsx prisma/backfill-inventory-component-type.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.23",
    "expr-eval": "^2.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "16.2.10",
    "next-intl": "^4.13.2",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
